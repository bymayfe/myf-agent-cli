# ==============================================================================
# Multi-Agent Sistem (.gitignore)
# ==============================================================================

# ── Python & Bytecode ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
/lib/
/lib64/
!web_ui/src/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
# ── Large Binaries (>100MB) ──────────────────────────────────────────────────
*.exe
*.gguf
/models/
llama_server/models/*
!llama_server/models/.gitkeep
!web_ui/src/app/api/models/
third_party/codebase_memory/codebase-memory-mcp*
!third_party/codebase_memory/*.ps1
!third_party/codebase_memory/*.sh
!third_party/codebase_memory/*.bat
!third_party/codebase_memory/*.md
!third_party/codebase_memory/LICENSE

# ── Virtual Environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ── Test & Quality Tools ──────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/
.ruff_cache/
.mypy_cache/

# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
agent_system/.env
*.env.local
*.env.*.local
!agent_system/.env.example

# ── Logs & Databases ──────────────────────────────────────────────────────────
*.log
agent_system.log
agent_system/agent_system.log
*.db
*.sqlite
*.sqlite3
logs.db
.external_sessions.json
agent_system/projects/.external_sessions.json

# ── Codebase Memory & Graph Cache ─────────────────────────────────────────────
.codebase-memory/
.repomap.tags.cache.v*/
*.zst

# ── Generated Projects & Temporary Workspace ─────────────────────────────────
agent_system/output_project/*
!agent_system/output_project/.gitkeep

agent_system/projects/*
!agent_system/projects/.gitkeep
!agent_system/projects/.current_project

.myfcli/temp_codes/
**/temp_codes/
checkpoint.json

# ── IDEs & Operating System ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
*.zip
.myfcli/
