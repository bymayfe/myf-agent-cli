# ─────────────────────────────────────────────────────────────────────
# Multi-Agent Sistem Yapilandirmasi
# Bu dosyayi ".env" olarak kopyalayip kendi degerlerinizi girin.
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────────

# ── SUNUCU SECIMI ─────────────────────────────────────────────────────
# Kullanmak istediginiz sunucu: ollama | lm_studio | openrouter
SERVER=ollama

# ── MODEL SECIMI ──────────────────────────────────────────────────────
# Ollama ornekleri (once: ollama pull <model_adi>):
DEFAULT_MODEL=ollama/qwen2.5-coder:7b

# Diger Ollama secenekleri (sisteminize gore):
# DEFAULT_MODEL=ollama/qwen2.5-coder:14b   # Daha iyi, 8GB VRAM sikisik
# DEFAULT_MODEL=ollama/llama3.1:8b         # Genel amac
# DEFAULT_MODEL=ollama/deepseek-r1:7b      # Reasoning/analiz
# DEFAULT_MODEL=ollama/gemma3:9b           # Google modeli

# LM Studio ornekleri:
# SERVER=lm_studio
# DEFAULT_MODEL=lm_studio/lmstudio-community/Qwen2.5-Coder-7B-Instruct-GGUF

# OpenRouter ornekleri (cloud, API key gerekli):
# SERVER=openrouter
# DEFAULT_MODEL=openrouter/qwen/qwen-2.5-coder-32b-instruct
# OPENROUTER_API_KEY=sk-or-...

# ── KOORDINATOR MODELI (opsiyonel) ────────────────────────────────────
# Koordinator ajani icin farkli model kullanmak isterseniz:
# COORD_MODEL=ollama/llama3.1:8b

# ── AJAN BAZLI MODEL ATAMASI (opsiyonel) ─────────────────────────────
# Her agana farkli model vermek isterseniz:
# PM_MODEL=ollama/llama3.1:8b
# ARCH_MODEL=ollama/qwen2.5:7b
# DEV_MODEL=ollama/qwen2.5-coder:7b
# QA_MODEL=ollama/qwen2.5-coder:7b
# REV_MODEL=ollama/deepseek-r1:7b

# ── LLM PARAMETRELERI ─────────────────────────────────────────────────
TEMPERATURE=0.3
MAX_TOKENS=8192

# ── REPOMAP TOKEN BUTCESI ─────────────────────────────────────────────
REPOMAP_TOKENS=2048

# ─────────────────────────────────────────────────────────────────────
# KURULUM NOTLARI
# ─────────────────────────────────────────────────────────────────────
# Ollama kurulumu (Windows):
#   winget install Ollama.Ollama
#   ollama serve          <- arka planda baslat
#   ollama pull qwen2.5-coder:7b
#
# RTX 4070 8GB icin onerilir:
#   qwen2.5-coder:7b     -> ~4.5GB VRAM (en iyi coding)
#   llama3.1:8b          -> ~5.0GB VRAM (genel amac)
#   deepseek-r1:7b       -> ~4.5GB VRAM (reasoning)
#   gemma3:9b            -> ~5.5GB VRAM (alternatif)
# ─────────────────────────────────────────────────────────────────────
